# ==============================================================================
# SING! Web Studio & AI Engine - Environment Configuration Template
# Copy this file to .env and customize for your local setup.
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=127.0.0.1

# Optional: Spotify Developer API (for Spotify Web Playback SDK integration)
# Register an application at https://developer.spotify.com/dashboard
# Redirect URI: http://127.0.0.1:3000/
SPOTIFY_CLIENT_ID=

# Optional: Spicy Lyrics API Key (for synced syllable-level lyrics provider)
SPICY_LYRICS_KEY=

# Optional: AI Pipeline Hardware Device ('auto', 'cpu', 'cuda', 'mps')
# Defaults to auto-detecting Apple Silicon MPS or NVIDIA CUDA
KARAOKE_DEVICE=auto
