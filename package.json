{
  "name": "sing",
  "version": "1.0.0",
  "description": "Full-stack browser-based SingStar & Let's Sing-style karaoke studio with real-time pitch detection and AI chart generator",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "node tests/resolver_test.js && node tests/jobs_test.js && node tests/settings_test.js && node tests/stem_mixer_test.js && node tests/pitch_tracking_test.js && node tests/highway_rendering_test.js && node tests/calibration_test.js && node tests/robustness_test.js && node tests/engine_test.js",
    "test:resolver": "node tests/resolver_test.js",
    "test:jobs": "node tests/jobs_test.js",
    "test:settings": "node tests/settings_test.js",
    "test:mixer": "node tests/stem_mixer_test.js",
    "test:pitch": "node tests/pitch_tracking_test.js",
    "test:highway": "node tests/highway_rendering_test.js",
    "test:calibration": "node tests/calibration_test.js",
    "test:robustness": "node tests/robustness_test.js",
    "test:engine": "node tests/engine_test.js",
    "test:ai": "python3 -m unittest tests/test_karaoke_pipeline.py",
    "test:regression": "bash scripts/check.sh",
    "check": "bash scripts/check.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codeggerer/SING.git"
  },
  "keywords": [
    "karaoke",
    "singstar",
    "pitch-detection",
    "mc-leod-pitch-method",
    "web-audio-api",
    "ultrastar",
    "spotify",
    "youtube"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "license": "MIT"
}
